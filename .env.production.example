# NON-SECRET TEMPLATE ONLY. Incomplete values intentionally block production.
# Provision new credentials in the Vercel Production scope, never Preview/DEV.
# Never copy .env.local, staging keys, PIN pepper or device material here.
APP_ENV=production
VITE_APP_ENV=production
SUPABASE_PROJECT_REF=
VITE_SUPABASE_PROJECT_REF=
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Existing verified Vercel Production hostname; no new domain is assumed.
APP_ORIGIN=https://horecamodular.vercel.app
VITE_APP_ORIGIN=https://horecamodular.vercel.app
PERSONNEL_ORIGIN=https://horecamodular.vercel.app
VITE_DEV_PASSWORD_AUTH=false
# Choose and verify the production Auth login policy before activation.
VITE_PASSWORD_AUTH=false
VITE_RELEASE_SHA=
PERSONNEL_BACKEND_ENABLED=false
PERSONNEL_PIN_PEPPER=
# Push is outside the attendance foundation; no production VAPID or cron setup.
