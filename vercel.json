{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "module/personnel": false
    }
  },
  "functions": {
    "api/sales.ts": {
      "maxDuration": 60
    },
    "api/sales-webhook.ts": {
      "maxDuration": 10
    },
    "api/personnel-reminders.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/personal/fichaje", "destination": "/personal/fichaje/index.html" },
    { "source": "/personal/fichaje/", "destination": "/personal/fichaje/index.html" },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
