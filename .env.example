# ===================================================
# HORECA MODULAR — Plantilla de Variables de Entorno
# ===================================================
# Para desarrollo local: copiar a .env.local y asignar los valores reales.
# Para Vercel: Cargar estas variables en el Dashboard de Vercel (Project Settings -> Environment Variables)
# ===================================================

# --- SUPABASE STAGING CONFIGURATION ---
VITE_APP_ENV=development
APP_ENV=development
VITE_SUPABASE_URL=https://vmxjqwlfwnphorthhcwu.supabase.co
VITE_SUPABASE_PROJECT_REF=vmxjqwlfwnphorthhcwu
SUPABASE_PROJECT_REF=vmxjqwlfwnphorthhcwu
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=your-legacy-supabase-anon-key

# --- DEV-ONLY TEMPORARY PASSWORD AUTH FLAG ---
# Set to 'true' in DEV/Preview environment to enable email/password login form.
# Leave unset or 'false' in Production to render OAuth buttons only.
VITE_DEV_PASSWORD_AUTH=true

# Personnel uses the persistent UI in DEV; backend and entitlement remain explicit.
# Backend-only settings. Never prefix these secrets with VITE_. No values supplied.
PERSONNEL_BACKEND_ENABLED=false
PERSONNEL_ORIGIN=
PERSONNEL_PIN_PEPPER=
SUPABASE_URL=https://vmxjqwlfwnphorthhcwu.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# No production fallback. Use .env.production.example as a separate checklist.

# Backend-only Web Push configuration; separate DEV secrets. Never VITE_ private keys.
PERSONNEL_VAPID_PUBLIC_KEY=
PERSONNEL_VAPID_PRIVATE_KEY=
PERSONNEL_VAPID_SUBJECT=
PERSONNEL_CRON_SECRET=
