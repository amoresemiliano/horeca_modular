# ===================================================
# HORECA MODULAR — Plantilla de Variables de Entorno
# ===================================================
# Para desarrollo local: copiar a .env.local y asignar los valores reales.
# Para Vercel: Cargar estas variables en el Dashboard de Vercel (Project Settings -> Environment Variables)
# ===================================================

# --- SUPABASE STAGING CONFIGURATION ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=your-legacy-supabase-anon-key

# --- DEV-ONLY TEMPORARY PASSWORD AUTH FLAG ---
# Set to 'true' in DEV/Preview environment to enable email/password login form.
# Leave unset or 'false' in Production to render OAuth buttons only.
VITE_DEV_PASSWORD_AUTH=true

# Personnel interactive prototype: automatic in vite dev; production stays on
# the existing module unless this flag is explicitly enabled for a preview.
# Synthetic in-memory data only. This does not enable the production HR backend.
VITE_PERSONNEL_PROTOTYPE=false

# WP-PERS-001: leave disabled until Master reviews/applies the migrations.
VITE_PERSONNEL_ATTENDANCE_ENABLED=false
# Backend-only settings. Never prefix these secrets with VITE_. No values supplied.
PERSONNEL_BACKEND_ENABLED=false
PERSONNEL_ORIGIN=
PERSONNEL_PIN_PEPPER=
